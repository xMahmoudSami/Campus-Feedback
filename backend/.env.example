# ==============================================================================
# Student Feedback System - Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production .env files to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (comma-separated allowed origins or * for open development)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Database Configuration (PostgreSQL)
# When running within Docker Compose, DB_HOST should match the database service name ('database').
# When running Node.js directly on the host machine without containers, set DB_HOST to 'localhost'.
DB_HOST=database
DB_PORT=5432
DB_USER=feedback_user
DB_PASSWORD=feedback_password
DB_NAME=student_feedback_db
DB_SSL=false
# Alternatively, specify a full DATABASE_URL:
# DATABASE_URL=postgresql://feedback_user:feedback_password@database:5432/student_feedback_db

# PostgreSQL Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=10000

# Authentication & Security
# WARNING: Always set a strong, unique secret in production!
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h

# Official Demo Accounts (Intended for local development and coursework demonstration only)
# WARNING: Do NOT automatically provision these known demo credentials in production environments!
# Admin Account: admin / admin@example.com / admin123
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin123

# Student Account: student / student@example.com / student123
INITIAL_STUDENT_USERNAME=student
INITIAL_STUDENT_EMAIL=student@example.com
INITIAL_STUDENT_PASSWORD=student123
